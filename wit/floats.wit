package lambkin:runtime@0.1.0;

/// IEEE-754 binary64 (f64) formatting and parsing.
interface floats {
    /// Notation style for formatted output.
    enum notation {
        /// Fixed-point decimal: 123.456000
        decimal,
        /// Scientific/exponential: 1.234560e+02
        scientific,
        /// General — whichever of decimal or scientific is shorter: 123.456
        general,
        /// Hexadecimal floating-point: 0x1.921fb54442d18p+1
        hex,
    }

    /// Character used for the decimal point.
    variant decimal-point {
        /// ASCII period '.'
        dot,
        /// ASCII comma ','
        comma,
        /// Unicode middle dot U+00B7
        middle-dot,
        /// Arabic decimal separator U+066B
        arabic-decimal,
        /// Any other string.
        other(string),
    }

    /// Character used as thousands separator.
    variant thousands-sep {
        /// No separator.
        none,
        /// ASCII comma ','
        comma,
        /// ASCII period '.'
        dot,
        /// ASCII space ' '
        space,
        /// Unicode narrow no-break space U+202F
        narrow-nbsp,
        /// Unicode no-break space U+00A0
        nbsp,
        /// ASCII apostrophe
        apostrophe,
        /// ASCII underscore
        underscore,
        /// Any other string.
        other(string),
    }

    /// What happens after explicit group sizes are exhausted.
    enum grouping-tail {
        /// No more separators.
        stop,
        /// Continue repeating the last group size.
        repeat-last,
    }

    /// First group size then repeating subsequent size.
    record first-then-repeat-rule {
        first: u8,
        next: u8,
    }

    /// Explicit sequence of group sizes.
    record explicit-grouping-rule {
        /// Group sizes from least-significant end.
        groups: list<u8>,
        /// Behavior after the sequence is exhausted.
        tail: grouping-tail,
    }

    /// Rule for how digits are grouped.
    variant grouping-rule {
        /// Insert separator every n digits, repeating forever.
        repeat(u8),
        /// Use first for the least-significant group, then repeat next.
        first-then-repeat(first-then-repeat-rule),
        /// Apply an explicit finite sequence of group sizes from the right.
        explicit(explicit-grouping-rule),
    }

    /// Digit grouping configuration.
    record digit-grouping {
        /// The grouping rule to apply.
        rule: grouping-rule,
        /// If false, do not group when fewer than 2 groups would result.
        require-separator: bool,
    }

    /// Locale-specific numeric formatting settings.
    record numeric-locale {
        /// Character for the decimal point.
        decimal-point: decimal-point,
        /// Character for the thousands separator.
        thousands-sep: thousands-sep,
        /// How to group integer digits.
        grouping: digit-grouping,
    }

    /// Rounding mode for precision-limited formatting.
    enum rounding-mode {
        /// Round to nearest, ties to even (default, IEEE-754).
        nearest-even,
        /// Truncate toward zero.
        toward-zero,
        /// Round toward positive infinity.
        toward-positive,
        /// Round toward negative infinity.
        toward-negative,
    }

    /// Options controlling formatted output.
    record format-options {
        /// Which notation to use.
        notation: notation,
        /// Number of fractional digits (decimal/scientific) or significant
        /// digits (general).  none = style default.
        precision: option<u32>,
        /// Minimum field width.  If the formatted result is shorter, it is
        /// padded (with spaces by default, or zeros if zero-pad is set).
        /// none = no minimum width.
        width: option<u32>,
        /// Uppercase exponent letter and special tokens (E, INF, NAN).
        uppercase: bool,
        /// Keep trailing zeros and always show the decimal point.
        alternate-form: bool,
        /// Show '+' on non-negative values.
        always-sign: bool,
        /// Show ' ' where '+' would appear (ignored when always-sign is set).
        space-sign: bool,
        /// Pad with leading zeros between the sign and digits instead of
        /// spaces.  Only meaningful when width is set.  Ignored for inf/nan.
        /// Overridden by left-justify.
        zero-pad: bool,
        /// Left-align the result within the field width (pad on the right
        /// with spaces).  Overrides zero-pad when both are set.
        left-justify: bool,
        /// Locale-specific numeric formatting.  If absent, behave like
        /// POSIX/C locale (decimal '.', no grouping).
        locale: option<numeric-locale>,
        /// Rounding mode for precision-limited formatting.
        rounding: rounding-mode,
    }

    /// Why formatting failed.
    variant format-error {
        /// Requested notation or option is not supported by this build.
        unsupported,
        /// Invalid option combination.
        invalid,
    }

    /// Why parsing failed.
    variant parse-error {
        /// Input is not valid decimal float syntax.
        invalid,
        /// Value is outside representable range or parser coverage.
        out-of-range,
        /// Feature not available in this build configuration.
        unsupported,
    }

    /// A successfully parsed f64 with consumption info.
    record parsed-f64 {
        /// The parsed IEEE-754 binary64 value.
        value: f64,
        /// Number of input bytes consumed.
        parsed-length: u32,
    }

    /// Shortest round-trip decimal representation.
    /// Always succeeds — every f64 (including ±0, ±inf, NaN) has a
    /// valid shortest form.
    to-string: func(value: f64) -> string;

    /// Format an f64 with explicit notation and options.
    /// NaN is always unsigned ("nan"/"NAN") regardless of sign flags.
    format-f64: func(value: f64, options: format-options) -> result<string, format-error>;

    /// Parse a decimal string to f64.
    /// Accepts: optional sign, decimal digits with optional fraction and
    /// exponent, inf/infinity, nan (case-insensitive).
    /// When locale is provided, thousands separators are stripped and the
    /// locale decimal point is normalized to '.' before parsing.
    /// parsed-length reflects bytes consumed from the original input.
    parse-f64: func(text: string, locale: option<numeric-locale>) -> result<parsed-f64, parse-error>;
}

world floats-impl {
    export floats;
}
